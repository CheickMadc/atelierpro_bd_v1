# Configuration AtelierPro — copiez ce fichier en ".env" et remplissez vos valeurs.
# Le fichier .env est exclu de Git (.gitignore) : ne le publiez JAMAIS sur GitHub.
# Ce fichier d'exemple, lui, ne doit contenir AUCUNE vraie valeur.

# --- Coordonnées affichées sur le site (jamais écrites dans le code) ---
# Laissez vide pour masquer l'élément correspondant.
SOCIETE=
CONTACT_WHATSAPP=
CONTACT_TELEPHONE=
CONTACT_EMAIL=
CONTACT_VILLE=

# --- Tarif mensuel par atelier, en FCFA (affiché seulement si PAIEMENT_ACTIF=1) ---
PRIX_MENSUEL=

# --- Mode d'accès ---
# 0 = phase de test : application gratuite, aucun abonnement exigé ni affiché.
# 1 = paiements ouverts (abonnement Paystack, bandeau "abonnement expiré", etc.)
PAIEMENT_ACTIF=0

# Jours d'essai gratuit offerts à l'inscription (0 = pas d'essai).
# Sans effet tant que PAIEMENT_ACTIF=0 (tout est gratuit).
JOURS_ESSAI=0

# --- Clé Paystack (compte marchand : https://paystack.com) ---
# Tableau de bord Paystack > Settings > API Keys & Webhooks.
# Utilisez d'abord la clé de TEST (sk_test_...), puis la clé LIVE (sk_live_...).
# Sans clé, la page de paiement fonctionne en mode démo.
PAYSTACK_SECRET_KEY=
# Dans ce même écran Paystack, renseignez :
#   Callback URL : <BASE_URL>/paiement/retour
#   Webhook URL  : <BASE_URL>/paiement/webhook

# --- URL publique de votre site ---
# Indispensable pour le retour de paiement et le webhook Paystack.
# En local pour tester : utilisez ngrok (ex. https://xxxx.ngrok-free.app).
# En ligne : votre nom de domaine (ex. https://atelierpro.ci).
BASE_URL=http://127.0.0.1:5000

# --- Clé secrète Flask (sessions) — OBLIGATOIRE en ligne ---
# Générez-en une avec :  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Mode développement ---
# 1 = débogueur + rechargement auto (UNIQUEMENT sur votre ordinateur).
# Toujours 0 en ligne : le débogueur permet d'exécuter du code à distance.
FLASK_DEBUG=0

# --- Base de données (SQLite par défaut : fichier atelierpro.db) ---
# Laissez vide pour le fichier par défaut, ou indiquez un autre chemin.
# DB_PATH=/chemin/vers/atelierpro.db

# --- Page d'administration /admin/paiements ---
# Accessible au super-admin connecté. Optionnel : une clé longue et aléatoire
# permet aussi d'y accéder via /admin/paiements?cle=VOTRE_CLE. Vide = désactivé.
ADMIN_KEY=

# --- Super-admin (supervision de tous les ateliers) ---
# Connexion sur la page /connexion habituelle avec ces identifiants.
# Laissés vides, la connexion super-admin est désactivée.
# Mot de passe : au moins 12 caractères, unique, jamais réutilisé ailleurs.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Reçu par E-MAIL (SMTP) — optionnel ---
# Exemple avec Gmail : créez un "mot de passe d'application" (pas votre mot de
# passe habituel). Laissez vide pour désactiver l'e-mail.
# Ex. : SMTP_HOST=smtp.gmail.com  SMTP_USER=votre_adresse@gmail.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Reçu par WHATSAPP (Twilio) — optionnel ---
# Compte Twilio > WhatsApp. Laissez vide pour désactiver l'envoi automatique
# (un lien "click-to-send" WhatsApp reste proposé dans tous les cas).
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
